{
  "name": "folio",
  "productName": "Folio",
  "version": "1.0.0",
  "description": "Offline PDF editor",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "icon": "node scripts/make-icon.js",
    "package": "node scripts/package.js",
    "test:signing": "node scripts/test-signing.js",
    "ios": "npm run vendor && cap sync ios && cap open ios",
    "android": "npm run vendor && cap sync android && cap open android",
    "mobile:sync": "npm run vendor && cap sync",
    "package:mac": "npx --yes node@22 scripts/package.js --mac",
    "mobile:assets": "npm run icon && node scripts/mobile-assets.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@electron/packager": "^18.4.4",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "buffer": "^6.0.3",
    "electron": "^41.7.1",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^3.11.174",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1"
  },
  "allowScripts": {
    "electron@41.7.1": true,
    "tesseract.js@5.1.1": true
  }
}
